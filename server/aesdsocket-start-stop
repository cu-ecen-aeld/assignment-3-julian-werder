#!/bin/sh
# Init script for the aesdsocket server (assignment 5).
# Installed by Buildroot as /etc/init.d/S99aesdsocket. "start" launches
# aesdsocket in daemon mode; "stop" sends it SIGTERM so it cleans up and exits.

case "$1" in
    start)
        echo "Starting aesdsocket"
        start-stop-daemon -S -n aesdsocket -a /usr/bin/aesdsocket -- -d
        ;;
    stop)
        echo "Stopping aesdsocket"
        start-stop-daemon -K -n aesdsocket -s TERM
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

exit 0
